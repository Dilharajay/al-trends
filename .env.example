# ==============================================================================
# Environment Configuration Template (.env.example)
# Duplicate this file to .env and configure secrets and environment variables.
# NEVER commit the actual .env file to source control.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=production
APP_NAME="Sri Lanka A/L Cutoff AI"

# Server Network Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Security & Secrets
# Generate a secure 32+ byte hex key in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=replace_this_with_a_secure_random_secret_key_in_production

# CORS Allowed Origins (Comma-separated)
# In production, specify exact domains e.g.: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*

# Rate Limiting Policies (slowapi format: X/minute, X/hour)
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_PREDICT=30/minute
RATE_LIMIT_BATCH=10/minute
RATE_LIMIT_STUDENT=20/minute

# Frontend API Endpoint (Used during React build / deployment)
# If frontend is served by FastAPI on same origin, keep as "" or relative path
VITE_API_URL=
