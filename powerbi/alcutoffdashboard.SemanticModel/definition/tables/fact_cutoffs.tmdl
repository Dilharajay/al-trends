table fact_cutoffs
	lineageTag: 00b61626-a822-4a29-9d89-1d12090efaec

	measure 'Average Cutoff Z' = AVERAGE(fact_cutoffs[CutoffZ])
		lineageTag: f390e50b-eb35-4964-8867-e1bace163afb

	measure 'Available Cources' =
			CALCULATE(
			    DISTINCTCOUNT(fact_cutoffs[CourseID]),
			    fact_cutoffs[CutoffStatus] = "AVAILABLE"
			)
		formatString: 0
		lineageTag: b89e2529-7a54-4bb4-b990-64711a070e71

	measure 'NQC Count' =
			CALCULATE(
			    COUNTROWS(fact_cutoffs),
			    fact_cutoffs[CutoffStatus] = "NQC"
			)
		lineageTag: b709bfb6-27a2-4972-86ef-5d005f147756

	measure 'highest zscore' = MAX(fact_cutoffs[CutoffZ])
		lineageTag: 704da107-6e6a-4737-9bc0-53e2c4231db1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Competitiveness Index' = ```
			
			        VAR GlobalMin = 
			            CALCULATE(
			                MIN('fact_cutoffs'[CutoffZ]), 
			                ALL('fact_cutoffs')
			            )
			        VAR GlobalMax = 
			            CALCULATE(
			                MAX('fact_cutoffs'[CutoffZ]), 
			                ALL('fact_cutoffs')
			            )
			        VAR GlobalRange = GlobalMax - GlobalMin
			        VAR CourseMean = AVERAGE('fact_cutoffs'[CutoffZ])
			        VAR CourseStdDev = STDEV.P('fact_cutoffs'[CutoffZ])
			        VAR NormalizedMean = 
			            DIVIDE(CourseMean - GlobalMin, GlobalRange, 0) * 100
			        VAR VolatilityPenalty = 
			            DIVIDE(COALESCE(CourseStdDev, 0), GlobalRange, 0) * 100 * 0.25
			        VAR RawIndex = NormalizedMean - VolatilityPenalty
			        RETURN
			            IF(
			                NOT(ISBLANK(CourseMean)),
			                MAX(0, MIN(100, RawIndex)),
			                BLANK()
			            )
			```
		lineageTag: 1e583706-7ff9-42b4-ab96-a69de372f881

		annotation PBI_FormatHint = {"isGeneralNumber":true}

